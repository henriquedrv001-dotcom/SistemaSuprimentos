{
  "name": "aplicativo-suprimentos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.mjs",
    "build:release": "node scripts/build-release.mjs",
    "test:api": "node --test tests/api.integration.test.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/restore-backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
