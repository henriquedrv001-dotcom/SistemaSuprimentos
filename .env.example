# Somente servidor. Nunca usar VITE_DATABASE_URL ou publicar este valor.
DATABASE_URL=postgresql://USUARIO:SENHA@SEU-HOST.neon.tech/neondb?sslmode=require
# Endereço HTTPS exato; no Render, pode omitir para usar RENDER_EXTERNAL_URL.
APP_ORIGIN=https://SEU-SERVICO.onrender.com
# Para testar o frontend remoto no Vite; build:release define isso automaticamente.
VITE_APP_MODE=production
PORT=3001
